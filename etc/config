
# This property is used by the clients to connect to IceStorm.
Proxies.TopicManager = "IceStorm/TopicManager:default -p 9999"

# Endpoints for implements interfaces
Endpoints.Camera360RGB = "tcp -p 10098"
Endpoints.CameraRGBDSimple = "tcp -p 10096"
Endpoints.IMU = "tcp -p 10007"
Endpoints.Laser = "tcp -p 10003"
Endpoints.Lidar3D = "tcp -p 11988"
Endpoints.OmniRobot = "tcp -p 10004"
Endpoints.VisualElements = "tcp -p 10005"
Endpoints.Webots2Robocomp = "tcp -p 10006"

# Endpoints for subscriptions interfaces
Endpoints.JoystickAdapterTopic = "tcp -p 11025"
Endpoints.JoystickAdapterPrefix = ""

# Proxies for publishes interfaces
Proxies.FullPoseEstimationPubPrefix = ""

# Step/actuation rate. This is what bounds how quickly a setSpeedBase command
# reaches the wheels, so lower it to tighten the control loop. Must be a multiple
# of the world's basicTimeStep (16 in Shadow_v2.wbt).
Period.Compute = 8

# Sampling rate for the heavy sensors (lidars, 360 camera, zed). Independent of
# Period.Compute, so the loop above can be made faster without multiplying point
# cloud and image processing cost. Clamped up to Period.Compute if set lower.
# Defaults to Period.Compute when absent.
Period.Sensors = 32

Period.Emergency = 500
Camera.ZED.points3D = False

Component.Debug.Verbose = true

# Give OmniRobot its own dispatch thread. Without this all adapters share the
# single default server thread pool, so a setSpeedBase/getBaseState call queues
# behind whatever lidar or camera call is being marshalled at that instant.
omnirobot.ThreadPool.Size = "2"
omnirobot.ThreadPool.SizeMax = "4"

# Shared pool for the remaining adapters: still enough that a large Lidar3D or
# Camera360 payload does not serialise the small IMU/VisualElements calls.
Ice.ThreadPool.Server.Size = "4"
Ice.ThreadPool.Server.SizeMax = "8"

Ice.Warn.Connections = "0"
Ice.Trace.Network = "0"
Ice.Trace.Protocol = "0"
Ice.MessageSizeMax = "20004800"
